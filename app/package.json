{
  "name": "liveproject",
  "productName": "LiveProject",
  "version": "0.1.1",
  "description": "Vista previa en vivo multi-dispositivo para proyectos con cualquier backend (PHP, Python, Node, ...)",
  "main": "src/main/main.js",
  "desktopName": "liveproject.desktop",
  "bin": {
    "liveproject": "bin/liveproject.js"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage deb",
    "build:deb": "electron-builder --linux deb"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.liveproject.app",
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Vista previa en vivo multi-dispositivo",
      "maintainer": "Edgar <e.gm27@outlook.com>",
      "target": [
        "deb",
        "AppImage"
      ]
    },
    "artifactName": "liveproject_${version}_${arch}.${ext}",
    "deb": {
      "packageName": "liveproject",
      "priority": "optional"
    }
  },
  "author": {
    "name": "Edgar",
    "email": "e.gm27@outlook.com"
  },
  "homepage": "https://liveproject.iguzman.com.mx",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMR027/liveproject.git"
  },
  "license": "MIT"
}
